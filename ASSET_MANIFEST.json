  "version": 2,
  "notes": "Delivered illustrated runtime inventory. Every listed PNG is used by the game. Source images stay at their native generated resolution. Runtime illustrations are individual poses, not animated sheets. See ART_GUIDE.md for source and rendering contracts.",
  "spriteContract": {
    "sourceLayout": "single-image",
    "frameWidth": 256,
    "frameHeight": 256,
    "feetAnchor": {
      "x": 128,
      "y": 236
    },
    "minTransparentPadding": 4,
    "visibleAlphaCutoff": 16,
    "bodyAlphaThreshold": 128,
    "format": "PNG RGBA (color type 6), straight alpha, no baked background or ground shadow",
    "sourceDimensions": "Native generated dimensions, 64–4096px per side. No multiple-of-frame requirement and no source-pixel feet row.",
    "normalization": "The client reads visible alpha bounds, identifies the structural body and feet, and draws a cached 256×256 runtime texture. Source PNG files are not resized, cropped or overwritten.",
    "facingNote": "One right-facing three-quarter pose. Left-facing display is mirrored. No unseen directional animation frames are claimed.",
    "animationNote": "Movement, breathing, lean, recoil, squash, lunge and effects animate the single illustrated pose at runtime. These sources are not hand-drawn animation strips or rigged 3D models.",
    "worldScale": "The renderer uses normalized body bounds and target display height rather than source-image dimensions. Level-based visual growth is separate from gameplay collision and range.",
    "visualGrowth": "Four small juvenile base forms grow visually with level; the saved level-10 evolution selects one of eight distinct mature illustrations. Growth does not change the lineage or its saved gameplay statistics.",
    "sourceBudgets": {
      "maxFileBytes": 16777216,
      "maxDecodedPixels": 16777216,
      "maxIllustrationSide": 4096
    }
  },
  "legacySpriteSheetContract": {
    "columnsPerFacing": 40,
    "maxFacingRows": 4,
    "note": "Validator compatibility for previously aligned frames only. No current inventory item uses a sprite sheet."
  },
