{
  "name": "energy-fight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @ef/client",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && tsx scripts/validate-config.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "tsx tests/e2e/browser.e2e.ts",
    "assets:validate": "tsx scripts/validate-assets.ts"
  }
}
