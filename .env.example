# Copy to .env (never commit real values).
# PostgreSQL connection string, e.g. from Neon. When empty, the server uses an
# embedded PGlite database stored in DATA_DIR (fine for local development).
DATABASE_URL=
# Embedded database directory (only used without DATABASE_URL). Must be persistent storage if hosted.
DATA_DIR=.data/pglite
PORT=2567
HOST=0.0.0.0
# 1 enables the development-only test-profile seeding endpoint. Ignored when NODE_ENV=production.
DEV_TOOLS=1
NODE_ENV=development
# Client build only: game server origin when the client is hosted separately.
VITE_SERVER_URL=
